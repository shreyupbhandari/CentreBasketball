names(VerizonEmployees)
head(VerizonEmployees)
employee_model=fitModel(Employees~m*Year+b,data=VerizonEmployees)
coef(employee_model)
gf_point(Employees~Year,data=VerizonEmployees)%>%
slice_plot(employee_model(Year)~Year,bounds(Year=2007:2024))
employee_model(2035)
calories=c(223,33,22,13)
mass=c(0.7,70,600,4000)
gf_point(calories~mass)
gf_point(log(calories)~mass)
gf_point(log(calories)~log(mass))
calorie_model=fitModel(log(calories)~k*log(mass)+log(c))
coef(calorie_model)
calorie_model(50)
names(USTaxReceipts)
head(USTaxReceipts)
gf_point(Receipts~Quarter,data=USTaxReceipts)
gf_point(log(Receipts)~Quarter,data=USTaxReceipts)
gf_point(log(Receipts)~log(Quarter),data=USTaxReceipts)
tax_model=fitModel(log(Receipts)~k*(Quarter-1)+log(c),data=USTaxReceipts)
coef(tax_model)
gf_point(Receipts~Quarter,data=USTaxReceipts)%>%
slice_plot(tax_model(Quarter)~Quarter,bounds(Quarter=1:313))
