library(BSDA)
library(mosaicData)
library(openintro)
library(usdata)
library(tidyverse)
library(ggplot2)
#1.
sample_size =    50
success_number = 34
null_proportion = 0.80
direction = "less than"
num_sim = 1000000
set.seed(10)
phat_data = success_number/sample_size
#generating num_sim number of successes under the assumption that H_0 is true
count.null = rbinom(n=num_sim, size=sample_size, prob=null_proportion)
#calculating null statistics and storing them in p_hat vector
p_hat = count.null/sample_size
#putting count.null and p_hat in data frame
results = data.frame(count.null, p_hat)
#histogram of the null statistics
ggplot(data=results) +
geom_histogram(aes(x=p_hat, y=after_stat(count)/sum(after_stat(count))), breaks=seq(0,1,by=.1)) +
labs(x="Null statistic value", y="Proportion", title="Distribution of Null Statistics") +
geom_vline(xintercept=phat_data, color="red")
#calculating p-value
p_value = as.numeric(direction=="greater than")*sum(as.numeric(p_hat>=phat_data))/num_sim +
as.numeric(direction=="less than")*sum(as.numeric(p_hat<=phat_data))/num_sim +
as.numeric(direction=="not equal")*as.numeric(phat_data>=null_proportion)*(sum(as.numeric(p_hat>=phat_data))+
sum(as.numeric(p_hat<=round(null_proportion-(phat_data-null_proportion), 10))))/num_sim +
as.numeric(direction=="not equal")*as.numeric(phat_data<null_proportion)*(sum(as.numeric(p_hat<=phat_data))+
sum(as.numeric(p_hat>=round(null_proportion+(-phat_data+null_proportion), 10))))/num_sim
#outputting p-value
p_value
#a.
'
Null Hypothesis (Ho): p=0.80
Alternative Hypothesis (Ha): p<0.80
The p-value obtained from the Hypothesis test for this observation, rounded to two
decimal points, is 0.03.
The sample statistic (p-hat) is 34/50 or 0.68.
Since the significane level (0.05) is greater than the computed p-value (0.03), we can reject the
null hypothesis. This indicates that the observed result (68%) is unlikely to happen
by random chance if the true passing rate were 80%.
'
#b
'We might be making a Type I error. A type I error occurs when we reject a null hypothesis when it is true.
Since our decision was to reject Ho, there could be a possibility that the passing rate of the school
is 80%.'
#2.
sample_size = 250          #Size of sample
success_number = 185     #Number of successes in sample (How many students preferred the parameter of interest)
num_bootstrap = 100000         #Number of simulations/bootstrap resamples
#################################################################################################################
set.seed(229) #tells R where to start the random number generator
phat_data = success_number/sample_size #value of observed p-hat
#Initialize a vector of ones and zeros to represent the original data
data = c(rep(1,success_number), rep(0, sample_size-success_number))
#Initialize a vector of NAs to hold the bootstrap re sampled proportions
p_hat = rep(NA, num_bootstrap)
#the following loop populates the p_hat vector
for (trial in seq(1, num_bootstrap)){
resampled_data = sample(data, size=sample_size, replace=TRUE) #generate resampled data
p_hat[trial] = mean(resampled_data) #store bootstrap resampled proportion in p_hat vector
}
#putting p_hat vector in data frame
results = data.frame(p_hat)
#histogram of the bootstrap resampled proportions
ggplot(data=results) +
geom_histogram(aes(x=p_hat, y=after_stat(count)/sum(after_stat(count)))) +
labs(x="Bootstrap resampled proportion", y="Proportion of total", title="Distribution of Bootstrap Resampled Proportions") +
geom_vline(xintercept=phat_data, color="red")
conf_level = 0.99   #type the confidence level (as a decimal)
my_CI = quantile(x = p_hat, c((1-conf_level)/2,(1+conf_level)/2)) #calculating CI
my_CI #outputting CI
#a.
'The confidence interval, rounded to two decimal places is approximately (0.67,0.81).
We are 99% confident that the true proportion of all U.S. adults who support banning plastic straws is between 0.67 and 0.81.'
#b.
'No, the lawmakers should not consider the ban because to have enough evidence that more than 75% of adults support the ban, the entire
confidence interval should be above 0.75. Our interval ranges from 0.67 to 0.81. Becasue the lower end our interval is below 0.75, it is still
possible that the true proportion support is less than 75%.'
